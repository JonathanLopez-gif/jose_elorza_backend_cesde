# PostgreSQL
DB_NAME=db_name
DB_USERNAME=db_username
DB_PASSWORD=db_password
DB_PORT=db_port

# Para cuando la app corre en Docker (usado en docker-compose.yml)
DB_URL_DOCKER=db_url_docker

# Para cuando la app corre en tu máquina local (fuera de Docker)
DB_URL_LOCAL=db_url_local

# Mail (local: MailDev host=maildev port=1025 | producción: smtp.gmail.com 587 + auth/starttls true)
MAIL_HOST=mail_host
MAIL_PORT=mail_port
MAIL_USERNAME=mail_username
MAIL_PASSWORD=mail_password
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@joselorza.com
MAIL_FROM_NAME=José Fernando Elorza

# Server
SERVER_PORT=server_port
# Dominio público de la API (solo producción, usado por Nginx/SSL)
API_DOMAIN=api.joselorza.com
# URL del frontend (enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=jwt_secret
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
PASSWORD_RESET_EXPIRATION_MINUTES=30

# Admin Seed
ADMIN_EMAIL=admin_email
ADMIN_PASSWORD=admin_password
ADMIN_NAME=admin_name
ADMIN_TIMEZONE=UTC

# JPA (update crea/actualiza tablas; validate solo verifica que existan)
DDL_AUTO=update

# Agenda
PROVIDER_TIMEZONE=America/Bogota
PAYMENT_DEADLINE_HOURS=48
PENALTY_THRESHOLD_DAYS=7
PENALTY_RATE=0.10
REMINDER_HOURS_BEFORE=24
NO_SHOW_GRACE_HOURS=24

# Wompi (sandbox: llaves pub_test_ / test_integrity_ / test_events_)
WOMPI_ENABLED=false
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=http://localhost:5173/pago/resultado

# Global66
GLOBAL66_ENABLED=false
GLOBAL66_API_URL=
GLOBAL66_API_KEY=
GLOBAL66_WEBHOOK_SECRET=
GLOBAL66_ORDER_PATH=/payment-orders
GLOBAL66_SIGNATURE_HEADER=X-Global66-Signature
GLOBAL66_REDIRECT_URL=http://localhost:5173/pago/resultado
GLOBAL66_NOTIFICATION_URL=http://localhost:8080/api/payments/webhooks/global66

# Comprobante PDF
RECEIPT_ISSUER_NAME=José Fernando Elorza
RECEIPT_ISSUER_ID=
RECEIPT_ISSUER_EMAIL=contacto@joselorza.com

# Google Calendar (OAuth2 del administrador)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google-calendar/oauth2/callback
GOOGLE_CALENDAR_ID=primary
# openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_POST_AUTH_REDIRECT=http://localhost:5173/admin/google-calendar

# Integración con el frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAME_SITE=Lax
SLOT_STEP_MINUTES=60
MIN_NOTICE_HOURS=12

# Simulador de pasarelas SOLO para desarrollo (en producción debe ser false)
PAYMENTS_SANDBOX_ENABLED=false
PAYMENTS_SANDBOX_CHECKOUT_URL=http://localhost:5173/pago/checkout-simulado
